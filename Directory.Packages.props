<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="aweXpect.Chronology" Version="1.1.0" />
	</ItemGroup>
	<ItemGroup>
		<!-- DiffEngine 13.0.2 is the last version for netstandard2.0. -->
		<PackageVersion Include="DiffEngine" Version="13.0.2" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
		<PackageVersion Include="DiffEngine" Version="20.8.2" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
		<PackageVersion Include="Nullable" Version="1.3.1" />
		<PackageVersion Include="IsExternalInit" Version="1.0.3" />
		<PackageVersion Include="System.Collections.Immutable" Version="10.0.14" />
		<PackageVersion Include="Mono.Cecil" Version="0.11.6" />
		<PackageVersion Include="System.Net.Http" Version="4.3.4" />
		<PackageVersion Include="System.Text.Json" Version="10.0.14" />
		<PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Fallout.Common" Version="10.4.0" />
		<PackageVersion Include="Fallout.Components" Version="10.4.0" />
		<PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
		<PackageVersion Include="SharpCompress" Version="0.50.7" />
		<PackageVersion Include="NuGet.Frameworks" Version="7.9.0" />
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Meziantou.Analyzer" Version="2.0.163" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis" Version="4.11.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="4.8.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.8.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeRefactoring.Testing" Version="1.1.4" />
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.33" Condition="'$(TargetFramework)' != 'net10.0'" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageVersion Include="NUnit" Version="5.0.0" />
		<PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
		<PackageVersion Include="TUnit" Version="1.76.28" />
		<PackageVersion Include="TUnit.Assertions" Version="1.76.28" />
		<PackageVersion Include="TUnit.Core" Version="1.76.28" />
		<PackageVersion Include="TUnit.Engine" Version="1.76.28" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.v3" Version="4.0.2" />
		<PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
		<PackageVersion Include="xunit.v3.core" Version="4.0.2" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
		<PackageVersion Include="AutoFixture" Version="4.18.1" />
		<PackageVersion Include="coverlet.collector" Version="10.1.0" />
		<PackageVersion Include="FluentAssertions" Version="8.11.0" />
		<PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
		<PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
		<PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
		<PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
	</ItemGroup>
</Project>
