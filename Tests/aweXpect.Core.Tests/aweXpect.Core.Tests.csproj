<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<ProjectReference Include="..\..\Source\aweXpect.Core\aweXpect.Core.csproj"/>
		<ProjectReference Include="..\..\Source\aweXpect.Core.Generators\aweXpect.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect.Generators\aweXpect.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect\aweXpect.csproj"/>
	</ItemGroup>

	<!-- The netstandard2.0 build matches JSON values and memory by name, which only a package brings to .NET Framework. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="System.Text.Json"/>
	</ItemGroup>

	<!-- Testably.Abstractions.Testing brings System.Index in Microsoft.Bcl.Memory, which clashes with the polyfill visible from aweXpect.Core. -->
	<Target Name="AliasBclMemory" AfterTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' == 'net48'">
		<ItemGroup>
			<ReferencePath Condition="'%(Filename)' == 'Microsoft.Bcl.Memory'" Aliases="BclMemory"/>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Remove="Nullable"/>
		<PackageReference Include="aweXpect.Chronology"/>
		<PackageReference Include="Testably.Abstractions.Testing"/>
		<Using Include="Testably.Abstractions.Testing"/>
		<Using Include="System.TimeProvider" Alias="TimeProvider"/>
		<ProjectReference Include="..\..\Source\aweXpect.Analyzers\aweXpect.Analyzers.csproj"
						  PrivateAssets="all"
						  ReferenceOutputAssembly="false"
						  OutputItemType="Analyzer"
						  SetTargetFramework="TargetFramework=netstandard2.0"/>
		<ProjectReference Include="..\..\Source\aweXpect.Analyzers.CodeFixers\aweXpect.Analyzers.CodeFixers.csproj"
						  PrivateAssets="all"
						  ReferenceOutputAssembly="false"
						  OutputItemType="Analyzer"
						  SetTargetFramework="TargetFramework=netstandard2.0"/>
	</ItemGroup>

</Project>
