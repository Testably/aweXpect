<Project Sdk="Microsoft.NET.Sdk">

	<!--
	    Loads assemblies that record further source roots, which would affect every test in the process, so these tests
	    run in a test project of their own.
	-->

	<ItemGroup>
		<ProjectReference Include="..\..\Source\aweXpect.Snapshots\aweXpect.Snapshots.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\aweXpect.Core.Generators\aweXpect.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect.Generators\aweXpect.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect\aweXpect.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="IsExternalInit">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- A project reference does not import the build targets of the package, so they are imported here. -->
	<Import Project="$(MSBuildThisFileDirectory)../../Source/aweXpect.Snapshots/buildTransitive/aweXpect.Snapshots.targets"/>

	<!--
	    On .NET Framework, nothing is registered, as for a test project that cannot compile a module initializer, so that
	    the tests cover reading the recorded values from the loaded assemblies there, and the registered values elsewhere.
	-->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<AweXpectRegisteredMetadataKeys></AweXpectRegisteredMetadataKeys>
	</PropertyGroup>

</Project>
