<Project Sdk="Microsoft.NET.Sdk">

	<!--
	    A library that references a newer package than the runtime of the tests contains, whose build output does not
	    contain the package, so that the tests resolve it from the NuGet packages of the library.
	-->
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0</TargetFrameworks>
		<IsTestProject>false</IsTestProject>
		<OutputType>Library</OutputType>
		<SonarQubeExclude>true</SonarQubeExclude>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Remove="TUnit.Engine"/>
		<PackageReference Remove="Microsoft.Testing.Extensions.TrxReport"/>
		<PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage"/>
		<PackageReference Remove="aweXpect"/>
		<PackageReference Include="System.Text.Json"/>
	</ItemGroup>

</Project>
