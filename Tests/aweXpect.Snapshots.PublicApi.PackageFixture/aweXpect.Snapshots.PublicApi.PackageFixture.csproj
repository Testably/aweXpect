<Project Sdk="Microsoft.NET.Sdk">

	<!--
	    A library that references a newer package than the runtime of the tests contains, whose build output does not
	    contain the package, so that the tests resolve it from the NuGet packages of the library.
	-->
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0</TargetFrameworks>
		<IsTestProject>false</IsTestProject>
		<SonarQubeExclude>true</SonarQubeExclude>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Remove="xunit"/>
		<PackageReference Remove="xunit.runner.visualstudio"/>
		<PackageReference Remove="Microsoft.NET.Test.Sdk"/>
		<PackageReference Remove="coverlet.collector"/>
		<PackageReference Remove="aweXpect"/>
		<PackageReference Include="System.Text.Json"/>
	</ItemGroup>

</Project>
