<Project>

	<Import Project="$(MSBuildThisFileDirectory)/../Directory.Build.props" Condition="Exists('$(MSBuildThisFileDirectory)/../Directory.Build.props')"/>

	<PropertyGroup>
		<TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<NoWarn>701;1702;CA1845;S2699</NoWarn>
		<WarningsAsErrors>$(WarningsAsErrors);CS8620</WarningsAsErrors>
	</PropertyGroup>

	<!--
	    The tests run on TUnit as executables of the Microsoft.Testing.Platform. TUnit discovers them through
	    reflection instead of its source generator, which keeps the compilation of the large test projects fast and
	    lets test arguments refer to private nested and open generic types.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>
		<!-- The implicit usings of TUnit import `HookType` statically, whose `Assembly` clashes with `System.Reflection`. -->
		<TUnitImplicitUsings>false</TUnitImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TUnit.Engine"/>
		<PackageReference Include="AutoFixture"/>
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport"/>
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"/>
		<PackageReference Include="Nullable">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" Link="Shared/%(Filename)%(Extension)"/>
		<Using Include="TUnit.Core"/>
		<Using Include="aweXpect.TestHelpers"/>
	</ItemGroup>

	<!--
	    The mutation tests set `MutationTestHeapHardLimit` so that a mutant which allocates without bound hits the
	    limit quickly instead of exhausting the runner. It has to reach the test host alone - the environment variable
	    that would do the same applies to the compiler too, which needs far more than the test host ever does.
	-->
	<ItemGroup Condition="'$(MutationTestHeapHardLimit)' != ''">
		<RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="$(MutationTestHeapHardLimit)"/>
	</ItemGroup>

</Project>
