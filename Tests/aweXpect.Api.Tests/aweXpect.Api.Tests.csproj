<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<!-- The Release build of aweXpect references this package, so its public API is read against the same version. -->
		<PackageReference Include="aweXpect.Core"/>
		<PackageReference Include="aweXpect.Snapshots.PublicApi"/>
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport"/>
		<PackageReference Include="TUnit.Engine"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\aweXpect\aweXpect.csproj" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect.Core\aweXpect.Core.csproj" ReferenceOutputAssembly="false"/>
	</ItemGroup>

	<!--
	    The tests read the builds of all target frameworks of the referenced projects, but a project reference only
	    builds the one that matches the tests. Without the target framework, the same builds as in the solution are
	    requested, which MSBuild runs only once; DispatchToInnerBuilds builds them without packing.
	-->
	<Target Name="BuildAllTargetFrameworksOfReferencedProjects" AfterTargets="Build">
		<MSBuild Projects="@(ProjectReference)" Targets="DispatchToInnerBuilds" RemoveProperties="TargetFramework"/>
	</Target>

</Project>
