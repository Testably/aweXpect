<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="aweXpect.Snapshots.PublicApi"/>
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport"/>
		<PackageReference Include="TUnit.Engine"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\aweXpect\aweXpect.csproj" ReferenceOutputAssembly="false"/>
		<!-- aweXpect references this project, so its public API is read against the same version. -->
		<ProjectReference Include="..\..\Source\aweXpect.Core\aweXpect.Core.csproj"/>
		<ProjectReference Include="..\..\Source\aweXpect.Json\aweXpect.Json.csproj" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect.Reflection\aweXpect.Reflection.csproj" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect.Web\aweXpect.Web.csproj" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect.Xml\aweXpect.Xml.csproj" ReferenceOutputAssembly="false"/>
	</ItemGroup>

	<ItemGroup>
		<!-- The netstandard2.0 build of aweXpect.Json references a newer System.Text.Json than the runtime of the tests provides. -->
		<PackageReference Include="System.Text.Json"/>
	</ItemGroup>

	<!--
	    The tests read the builds of all target frameworks of the referenced projects, but a project reference only
	    builds the one that matches the tests. Without the target framework, the same builds as in the solution are
	    requested, which MSBuild runs only once; DispatchToInnerBuilds builds them without packing.
	-->
	<Target Name="BuildAllTargetFrameworksOfReferencedProjects" AfterTargets="Build">
		<MSBuild Projects="@(ProjectReference)" Targets="DispatchToInnerBuilds" RemoveProperties="TargetFramework"/>
	</Target>

</Project>
