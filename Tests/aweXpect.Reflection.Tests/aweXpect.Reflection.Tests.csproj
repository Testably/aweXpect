<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
		<!-- The strong-name tests use the test assembly as the example of an assembly without a strong name. -->
		<SignAssembly>False</SignAssembly>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\aweXpect.Core.Generators\aweXpect.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect.Generators\aweXpect.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect\aweXpect.csproj"/>
		<ProjectReference Include="..\..\Source\aweXpect.Reflection\aweXpect.Reflection.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<!-- Only the test project depends on Mono.Cecil (for the example dependency resolver);
		     the library stays dependency-free. -->
		<PackageReference Include="Mono.Cecil"/>
	</ItemGroup>

</Project>
