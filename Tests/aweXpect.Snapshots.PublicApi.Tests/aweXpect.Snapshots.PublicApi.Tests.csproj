<Project Sdk="Microsoft.NET.Sdk">

	<!--
	    Signed, so that the tests can select a reference pack from a directory of their own, which is internal. The
	    internal polyfills of the library are then visible as well, which collide with those of the tests (CS0436).
	-->
	<PropertyGroup>
		<SignAssembly>True</SignAssembly>
		<NoWarn>$(NoWarn);CS0436</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\aweXpect.Snapshots.PublicApi\aweXpect.Snapshots.PublicApi.csproj"/>
		<ProjectReference Include="..\aweXpect.Snapshots.PublicApi.Fixture\aweXpect.Snapshots.PublicApi.Fixture.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\aweXpect.Core.Generators\aweXpect.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect.Generators\aweXpect.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\..\Source\aweXpect\aweXpect.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="IsExternalInit">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!--
	    The package fixture is only built, as referencing it would copy its packages into the output of the tests.
	-->
	<ItemGroup>
		<ProjectReference Include="..\aweXpect.Snapshots.PublicApi.PackageFixture\aweXpect.Snapshots.PublicApi.PackageFixture.csproj"
		                  ReferenceOutputAssembly="false" PrivateAssets="all"/>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>PackageFixture</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)..\aweXpect.Snapshots.PublicApi.PackageFixture\bin\$(Configuration)\netstandard2.0\aweXpect.Snapshots.PublicApi.PackageFixture.dll</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<None Update="ThatPublicApi.MatchesPublicApiSnapshot.FileTests.*.awexpect-snapshot.*" DependentUpon="ThatPublicApi.MatchesPublicApiSnapshot.FileTests.cs"/>
		<None Update="ThatPublicApi.MatchesPublicApiSnapshot.Tests.*.awexpect-snapshot.*" DependentUpon="ThatPublicApi.MatchesPublicApiSnapshot.Tests.cs"/>
	</ItemGroup>

	<!-- A project reference does not import the build targets of the package, so they are imported here. -->
	<Import Project="$(MSBuildThisFileDirectory)../../Source/aweXpect.Snapshots/buildTransitive/aweXpect.Snapshots.targets"/>

</Project>
