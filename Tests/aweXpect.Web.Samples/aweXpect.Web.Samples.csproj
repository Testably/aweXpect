<Project Sdk="Microsoft.NET.Sdk.Web">

	<!--
	    The sample application that `aweXpect.Web.Samples.Tests` runs against. It is no test project itself and uses the
	    reflection-based minimal APIs.
	-->
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<IsTestProject>false</IsTestProject>
		<SonarQubeExclude>true</SonarQubeExclude>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Remove="TUnit.Engine"/>
		<PackageReference Remove="AutoFixture"/>
		<PackageReference Remove="Microsoft.Testing.Extensions.TrxReport"/>
		<PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage"/>
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Properties\launchSettings.json" />
	  <None Update="data\cover.png">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
