<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Assert unit tests in natural language using awesome expectations.</Description>
	</PropertyGroup>

	<!-- Unlike by default, the analyzers of aweXpect.Core reach the consumers, so that its expectation and type metadata generators also run in a project that only references aweXpect. -->
	<ItemGroup>
		<ProjectReference Include="..\aweXpect.Core\aweXpect.Core.csproj" PrivateAssets="contentfiles;build"/>
		<ProjectReference Include="..\aweXpect.Core.Generators\aweXpect.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="aweXpect.Internal.Tests" PublicKey="$(PublicKey)"/>
	</ItemGroup>

	<!-- Older versions of this package ship the type metadata generator themselves, so the copy in aweXpect.Core only runs next to an aweXpect with this marker. -->
	<ItemGroup>
		<AssemblyMetadata Include="aweXpect.TypeMetadataGenerator" Value="aweXpect.Core"/>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\aweXpect.Core\Core\Polyfills\CallerArgumentExpressionAttribute.cs" Link="Polyfills\CallerArgumentExpressionAttribute.cs"/>
		<Compile Include="..\aweXpect.Core\Core\Polyfills\Index.cs" Link="Polyfills\Index.cs"/>
		<Compile Include="..\aweXpect.Core\Core\Polyfills\OverloadResolutionPriorityAttribute.cs" Link="Polyfills\OverloadResolutionPriorityAttribute.cs"/>
		<Compile Include="..\aweXpect.Core\Core\Polyfills\Range.cs" Link="Polyfills\Range.cs"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\aweXpect.Analyzers\aweXpect.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<None Include="$(MSBuildProjectDirectory)\..\aweXpect.Analyzers\bin\$(Configuration)\netstandard2.0\aweXpect.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
		<ProjectReference Include="..\aweXpect.Analyzers.CodeFixers\aweXpect.Analyzers.CodeFixers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<None Include="$(MSBuildProjectDirectory)\..\aweXpect.Analyzers.CodeFixers\bin\$(Configuration)\netstandard2.0\aweXpect.Analyzers.CodeFixers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
		<ProjectReference Include="..\aweXpect.SourceGenerators\aweXpect.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<!-- Only a build dependency for packing: the generator runs in the consuming projects, not in this one. -->
		<ProjectReference Include="..\aweXpect.Generators\aweXpect.Generators.csproj" ReferenceOutputAssembly="false"/>
		<None Include="$(MSBuildProjectDirectory)\..\aweXpect.Generators\bin\$(Configuration)\netstandard2.0\aweXpect.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
	</ItemGroup>

</Project>
