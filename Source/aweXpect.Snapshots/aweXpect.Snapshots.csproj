<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>aweXpect</RootNamespace>
		<IsBetaPackage>true</IsBetaPackage>
		<Description>Snapshot testing for aweXpect.</Description>
		<PackageProjectUrl>https://docs.testably.org/Extensions/aweXpect.Snapshots</PackageProjectUrl>
		<PackageReadmeSourceFile>$(MSBuildProjectDirectory)/README.md</PackageReadmeSourceFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\aweXpect.Core\aweXpect.Core.csproj" PrivateAssets="contentfiles;build"/>
		<ProjectReference Include="..\aweXpect.Core.Generators\aweXpect.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\aweXpect.Core\Core\Polyfills\CallerArgumentExpressionAttribute.cs" Link="Polyfills\CallerArgumentExpressionAttribute.cs"/>
		<Compile Include="..\aweXpect.Core\Core\Polyfills\OverloadResolutionPriorityAttribute.cs" Link="Polyfills\OverloadResolutionPriorityAttribute.cs"/>
	</ItemGroup>

	<ItemGroup>
		<None Include="buildTransitive/aweXpect.Snapshots.targets" Pack="true" PackagePath="buildTransitive/"/>
	</ItemGroup>

</Project>
