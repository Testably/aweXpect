<Project>

	<!--
	    Registers the recorded values below from a module initializer that the source generator of aweXpect.Core emits
	    into the test project, so that they are read without scanning the assembly. The name of the assembly is
	    registered with them. Where the project cannot compile a module initializer, nothing is registered, and the values
	    are read from the assembly instead.
	-->
	<PropertyGroup>
		<AweXpectRegisteredMetadataKeys>$(AweXpectRegisteredMetadataKeys),aweXpect.Snapshots.SourceRoot,aweXpect.Snapshots.ProjectDirectory,aweXpect.Snapshots.TargetFramework,aweXpect.Snapshots.Assembly</AweXpectRegisteredMetadataKeys>
	</PropertyGroup>
	<ItemGroup>
		<CompilerVisibleProperty Remove="AweXpectRegisteredMetadataKeys"/>
		<CompilerVisibleProperty Include="AweXpectRegisteredMetadataKeys"/>
	</ItemGroup>

	<!--
	    Records the source root of the project in the test assembly as `<MappedPath>=<SourceRoot>`, so that a snapshot is
	    identified by the path of its test file relative to the source root, which is the same on every machine. A
	    deterministic build (e.g. with `ContinuousIntegrationBuild`) emits the mapped path, such as `/_/`, instead of the
	    source root, which is how the snapshots are found again in such a build.
	    Only the source root that contains the project is recorded, so that a relative path leads back to one directory.
	-->
	<Target Name="_AweXpectSnapshotsRecordSourceRoot"
			BeforeTargets="GetAssemblyAttributes"
			DependsOnTargets="InitializeSourceRootMappedPaths"
			Condition="'$(SourceRootMappedPathsFeatureSupported)' == 'true'">
		<ItemGroup>
			<_AweXpectSnapshotsSourceRoot Include="@(SourceRoot)"
										  Condition="'%(SourceRoot.NestedRoot)' == '' and !$([MSBuild]::MakeRelative('%(SourceRoot.Identity)', '$(MSBuildProjectDirectory)').StartsWith('..')) and !$([System.IO.Path]::IsPathRooted($([MSBuild]::MakeRelative('%(SourceRoot.Identity)', '$(MSBuildProjectDirectory)'))))"/>
		</ItemGroup>
		<ItemGroup Condition="'@(_AweXpectSnapshotsSourceRoot)' != ''">
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>aweXpect.Snapshots.SourceRoot</_Parameter1>
				<_Parameter2>%(_AweXpectSnapshotsSourceRoot.MappedPath)=%(_AweXpectSnapshotsSourceRoot.Identity)</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

	<!--
	    Records the directory of the project in the test assembly, so that `OrphanedSnapshots.CheckAsync()` only looks for
	    snapshots of this project, and never for those of another project in the same repository. Like the recorded source
	    root, it is the path on the machine that builds and runs the tests.
	    The target framework is recorded with it as `<TargetFramework>=<ProjectDirectory>`, so that
	    `.UniqueFor.TargetFramework()` names the snapshot after the target framework of the project of the test file.
	    The name of the assembly is recorded only to be registered, so that an assembly that registered its values is not
	    read again.
	-->
	<Target Name="_AweXpectSnapshotsRecordProjectDirectory"
			BeforeTargets="GetAssemblyAttributes">
		<ItemGroup>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>aweXpect.Snapshots.ProjectDirectory</_Parameter1>
				<_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
			</AssemblyAttribute>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
							   Condition="'$(TargetFramework)' != ''">
				<_Parameter1>aweXpect.Snapshots.TargetFramework</_Parameter1>
				<_Parameter2>$(TargetFramework)=$(MSBuildProjectDirectory)</_Parameter2>
			</AssemblyAttribute>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>aweXpect.Snapshots.Assembly</_Parameter1>
				<_Parameter2>$(AssemblyName)</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

	<!--
	    Never compiles a snapshot, also when it has the extension of a source file, e.g. with `.WithExtension("cs")`, which
	    the default items of the SDK include as `Compile` item. It is kept as `None` item instead, so that it stays visible
	    in the IDE and is nested like any other snapshot. The snapshots are taken from the `Compile` items instead of
	    searching the project directory again, which would slow down every build.
	-->
	<ItemGroup>
		<_AweXpectSnapshotsCompile Include="@(Compile)"/>
		<Compile Remove="**/*.awexpect-snapshot.*"/>
		<None Include="@(_AweXpectSnapshotsCompile)" Exclude="@(Compile)"/>
		<_AweXpectSnapshotsCompile Remove="@(_AweXpectSnapshotsCompile)"/>
	</ItemGroup>

	<!--
	    Nests each snapshot under its test file in Rider and Visual Studio, which take the nesting from the evaluation of
	    the project, so it is set on the items and not in a target. Test file names and snapshot names both contain dots,
	    so the test file is the longest prefix of up to eight parts of the file name for which a `.cs` file exists in the
	    same directory; a later match overwrites an earlier, shorter one. A `DependentUpon` that is already set is kept.
	    The `%` of the prefix is escaped again, as MSBuild would otherwise read an escaped name part, e.g. `%2E`, as a dot.
	    `<AweXpectSnapshotsNestFiles>false</AweXpectSnapshotsNestFiles>` turns it off.
	-->
	<ItemGroup Condition="'$(AweXpectSnapshotsNestFiles)' != 'false' and '$(Language)' == 'C#'">
		<None Update="**/*.awexpect-snapshot.*">
			<_AweXpectSnapshotsPrefix>$([System.Text.RegularExpressions.Regex]::Match('%(Filename)', '^[^.]+(?=\.)').Value.Replace('%', '%25'))</_AweXpectSnapshotsPrefix>
			<_AweXpectSnapshotsTestFile Condition="'%(_AweXpectSnapshotsPrefix)' != '' and Exists('%(RootDir)%(Directory)%(_AweXpectSnapshotsPrefix).cs')">%(_AweXpectSnapshotsPrefix).cs</_AweXpectSnapshotsTestFile>
			<_AweXpectSnapshotsPrefix>$([System.Text.RegularExpressions.Regex]::Match('%(Filename)', '^[^.]+(\.[^.]+){1}(?=\.)').Value.Replace('%', '%25'))</_AweXpectSnapshotsPrefix>
			<_AweXpectSnapshotsTestFile Condition="'%(_AweXpectSnapshotsPrefix)' != '' and Exists('%(RootDir)%(Directory)%(_AweXpectSnapshotsPrefix).cs')">%(_AweXpectSnapshotsPrefix).cs</_AweXpectSnapshotsTestFile>
			<_AweXpectSnapshotsPrefix>$([System.Text.RegularExpressions.Regex]::Match('%(Filename)', '^[^.]+(\.[^.]+){2}(?=\.)').Value.Replace('%', '%25'))</_AweXpectSnapshotsPrefix>
			<_AweXpectSnapshotsTestFile Condition="'%(_AweXpectSnapshotsPrefix)' != '' and Exists('%(RootDir)%(Directory)%(_AweXpectSnapshotsPrefix).cs')">%(_AweXpectSnapshotsPrefix).cs</_AweXpectSnapshotsTestFile>
			<_AweXpectSnapshotsPrefix>$([System.Text.RegularExpressions.Regex]::Match('%(Filename)', '^[^.]+(\.[^.]+){3}(?=\.)').Value.Replace('%', '%25'))</_AweXpectSnapshotsPrefix>
			<_AweXpectSnapshotsTestFile Condition="'%(_AweXpectSnapshotsPrefix)' != '' and Exists('%(RootDir)%(Directory)%(_AweXpectSnapshotsPrefix).cs')">%(_AweXpectSnapshotsPrefix).cs</_AweXpectSnapshotsTestFile>
			<_AweXpectSnapshotsPrefix>$([System.Text.RegularExpressions.Regex]::Match('%(Filename)', '^[^.]+(\.[^.]+){4}(?=\.)').Value.Replace('%', '%25'))</_AweXpectSnapshotsPrefix>
			<_AweXpectSnapshotsTestFile Condition="'%(_AweXpectSnapshotsPrefix)' != '' and Exists('%(RootDir)%(Directory)%(_AweXpectSnapshotsPrefix).cs')">%(_AweXpectSnapshotsPrefix).cs</_AweXpectSnapshotsTestFile>
			<_AweXpectSnapshotsPrefix>$([System.Text.RegularExpressions.Regex]::Match('%(Filename)', '^[^.]+(\.[^.]+){5}(?=\.)').Value.Replace('%', '%25'))</_AweXpectSnapshotsPrefix>
			<_AweXpectSnapshotsTestFile Condition="'%(_AweXpectSnapshotsPrefix)' != '' and Exists('%(RootDir)%(Directory)%(_AweXpectSnapshotsPrefix).cs')">%(_AweXpectSnapshotsPrefix).cs</_AweXpectSnapshotsTestFile>
			<_AweXpectSnapshotsPrefix>$([System.Text.RegularExpressions.Regex]::Match('%(Filename)', '^[^.]+(\.[^.]+){6}(?=\.)').Value.Replace('%', '%25'))</_AweXpectSnapshotsPrefix>
			<_AweXpectSnapshotsTestFile Condition="'%(_AweXpectSnapshotsPrefix)' != '' and Exists('%(RootDir)%(Directory)%(_AweXpectSnapshotsPrefix).cs')">%(_AweXpectSnapshotsPrefix).cs</_AweXpectSnapshotsTestFile>
			<_AweXpectSnapshotsPrefix>$([System.Text.RegularExpressions.Regex]::Match('%(Filename)', '^[^.]+(\.[^.]+){7}(?=\.)').Value.Replace('%', '%25'))</_AweXpectSnapshotsPrefix>
			<_AweXpectSnapshotsTestFile Condition="'%(_AweXpectSnapshotsPrefix)' != '' and Exists('%(RootDir)%(Directory)%(_AweXpectSnapshotsPrefix).cs')">%(_AweXpectSnapshotsPrefix).cs</_AweXpectSnapshotsTestFile>
			<DependentUpon Condition="'%(DependentUpon)' == '' and '%(_AweXpectSnapshotsTestFile)' != ''">%(_AweXpectSnapshotsTestFile)</DependentUpon>
		</None>
	</ItemGroup>

</Project>
