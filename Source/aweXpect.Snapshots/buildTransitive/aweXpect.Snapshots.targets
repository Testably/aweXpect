<Project>

	<!--
	    Records the source root of the project in the test assembly as `<MappedPath>=<SourceRoot>`, so that a snapshot is
	    identified by the path of its test file relative to the source root, which is the same on every machine. A
	    deterministic build (e.g. with `ContinuousIntegrationBuild`) emits the mapped path, such as `/_/`, instead of the
	    source root, which is how the snapshots are found again in such a build.
	    Only the source root that contains the project is recorded, so that a relative path leads back to one directory.
	-->
	<Target Name="_AweXpectSnapshotsRecordSourceRoot"
			BeforeTargets="GetAssemblyAttributes"
			DependsOnTargets="InitializeSourceRootMappedPaths"
			Condition="'$(SourceRootMappedPathsFeatureSupported)' == 'true'">
		<ItemGroup>
			<_AweXpectSnapshotsSourceRoot Include="@(SourceRoot)"
										  Condition="'%(SourceRoot.NestedRoot)' == '' and !$([MSBuild]::MakeRelative('%(SourceRoot.Identity)', '$(MSBuildProjectDirectory)').StartsWith('..')) and !$([System.IO.Path]::IsPathRooted($([MSBuild]::MakeRelative('%(SourceRoot.Identity)', '$(MSBuildProjectDirectory)'))))"/>
		</ItemGroup>
		<ItemGroup Condition="'@(_AweXpectSnapshotsSourceRoot)' != ''">
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>aweXpect.Snapshots.SourceRoot</_Parameter1>
				<_Parameter2>%(_AweXpectSnapshotsSourceRoot.MappedPath)=%(_AweXpectSnapshotsSourceRoot.Identity)</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

	<!--
	    Records the directory of the project in the test assembly, so that `OrphanedSnapshots.CheckAsync()` only looks for
	    snapshots of this project, and never for those of another project in the same repository. Like the recorded source
	    root, it is the path on the machine that builds and runs the tests.
	    The target framework is recorded with it as `<TargetFramework>=<ProjectDirectory>`, so that
	    `.UniqueFor.TargetFramework()` names the snapshot after the target framework of the project of the test file.
	-->
	<Target Name="_AweXpectSnapshotsRecordProjectDirectory"
			BeforeTargets="GetAssemblyAttributes">
		<ItemGroup>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>aweXpect.Snapshots.ProjectDirectory</_Parameter1>
				<_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
			</AssemblyAttribute>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
							   Condition="'$(TargetFramework)' != ''">
				<_Parameter1>aweXpect.Snapshots.TargetFramework</_Parameter1>
				<_Parameter2>$(TargetFramework)=$(MSBuildProjectDirectory)</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

</Project>
