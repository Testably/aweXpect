<Project>

	<!--
	    Registers the `DiffEngineReporter` for every snapshot by calling `DiffEngineReporter.Register()` from a module
	    initializer that the source generator of aweXpect.Core emits into the project, so that referencing the package is
	    enough. It is added to the reporters that are already set, and only once, also when several projects of the test
	    assembly reference the package.
	    `<AweXpectSnapshotsDiffEngine>false</AweXpectSnapshotsDiffEngine>` turns it off, e.g. to register the reporter
	    yourself.
	    The generator emits the module initializer only where the project can compile one (C# 9 and a
	    `ModuleInitializerAttribute`, which .NET Framework and .NET Core before .NET 5 only have as an own declaration), so
	    other projects register the reporter themselves.
	-->
	<PropertyGroup Condition="'$(AweXpectSnapshotsDiffEngine)' != 'false'">
		<AweXpectModuleInitializers>$(AweXpectModuleInitializers),aweXpect.Snapshots.DiffEngine.DiffEngineReporter.Register</AweXpectModuleInitializers>
	</PropertyGroup>
	<ItemGroup>
		<CompilerVisibleProperty Remove="AweXpectModuleInitializers"/>
		<CompilerVisibleProperty Include="AweXpectModuleInitializers"/>
	</ItemGroup>

</Project>
