<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Opens a diff tool with DiffEngine for snapshots of aweXpect.Snapshots that are missing or different.</Description>
		<IsBetaPackage>true</IsBetaPackage>
		<PackageProjectUrl>https://docs.testably.org/Extensions/aweXpect.Snapshots</PackageProjectUrl>
		<PackageReadmeSourceFile>$(RepositoryRoot)Docs/extensions/aweXpect.Snapshots/00-index.md</PackageReadmeSourceFile>
		<PackageReadmeSourceFile Condition="Exists('$(RepositoryRoot)Artifacts/aweXpect.Snapshots/README.md')">$(RepositoryRoot)Artifacts/aweXpect.Snapshots/README.md</PackageReadmeSourceFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\aweXpect.Snapshots\aweXpect.Snapshots.csproj" PrivateAssets="contentfiles;build"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DiffEngine"/>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="aweXpect.Snapshots.DiffEngine.Tests" Key="$(PublicKey)"/>
	</ItemGroup>

	<ItemGroup>
		<None Include="buildTransitive/aweXpect.Snapshots.DiffEngine.targets" Pack="true" PackagePath="buildTransitive/"/>
	</ItemGroup>

</Project>
