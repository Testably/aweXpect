<Project>

	<!--
	    A type without a registration is reflected over, which is unreliable when publishing with trimming or Native
	    AOT enabled, so the fallback is switched off there and such a type fails with a message naming the fix. Set
	    `AweXpectReflectionFallback` to `true` to keep reflecting anyway, or to `false` to reject it under the JIT.
	-->
	<PropertyGroup>
		<_AweXpectReflectionFallback>$(AweXpectReflectionFallback)</_AweXpectReflectionFallback>
		<_AweXpectReflectionFallback Condition="'$(_AweXpectReflectionFallback)' == '' and ('$(PublishTrimmed)' == 'true' or '$(PublishAot)' == 'true')">false</_AweXpectReflectionFallback>
	</PropertyGroup>

	<!--
	    The option is replaced rather than added, so that a second import through a project reference next to the
	    package adds it once. A consumer's own option for the switch is replaced as well; the property is the way to
	    set it.
	-->
	<ItemGroup Condition="'$(_AweXpectReflectionFallback)' != ''">
		<RuntimeHostConfigurationOption Remove="aweXpect.ReflectionFallback.IsSupported"/>
		<RuntimeHostConfigurationOption Include="aweXpect.ReflectionFallback.IsSupported"
										Value="$(_AweXpectReflectionFallback)"
										Trim="true"/>
	</ItemGroup>

	<!--
	    The registration hook for extensions reads the lists `AweXpectRegisteredMetadataKeys` and `AweXpectModuleInitializers`
	    from the `.editorconfig` that the compiler receives, where a `;` starts a comment and would silently drop the rest
	    of the list. So a `;`, as MSBuild lists are usually separated, is replaced with a `,` right before the file is
	    written, after every project file and package added its names.
	-->
	<Target Name="_AweXpectNormalizeRegistrationLists" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
		<PropertyGroup>
			<AweXpectRegisteredMetadataKeys>$(AweXpectRegisteredMetadataKeys.Replace(';', ','))</AweXpectRegisteredMetadataKeys>
			<AweXpectModuleInitializers>$(AweXpectModuleInitializers.Replace(';', ','))</AweXpectModuleInitializers>
		</PropertyGroup>
	</Target>

	<!--
	    MSTest marks `TestContext.Current` as experimental, so the generated adapter of MSTest only reads the running
	    test, its cancellation token and attachments when `AweXpectExperimentalMSTest` is `true`, and then suppresses
	    the diagnostic MSTESTEXP in its own code.
	-->
	<ItemGroup>
		<CompilerVisibleProperty Remove="AweXpectExperimentalMSTest"/>
		<CompilerVisibleProperty Include="AweXpectExperimentalMSTest"/>
	</ItemGroup>

</Project>
