<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Expectations for reflection types for aweXpect.</Description>
		<PackageProjectUrl>https://docs.testably.org/Extensions/aweXpect.Reflection</PackageProjectUrl>
		<PackageReadmeSourceFile>$(RepositoryRoot)Docs/extensions/aweXpect.Reflection/00-index.md</PackageReadmeSourceFile>
		<PackageReadmeSourceFile Condition="Exists('$(RepositoryRoot)Artifacts/aweXpect.Reflection/README.md')">$(RepositoryRoot)Artifacts/aweXpect.Reflection/README.md</PackageReadmeSourceFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\aweXpect.Core\aweXpect.Core.csproj" PrivateAssets="contentfiles;analyzers;build"/>
		<ProjectReference Include="..\aweXpect.Core.Generators\aweXpect.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="aweXpect.Reflection.Internal.Tests" PublicKey="$(PublicKey)"/>
	</ItemGroup>

</Project>
