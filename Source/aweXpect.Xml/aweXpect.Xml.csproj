<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>aweXpect</RootNamespace>
		<IsBetaPackage>true</IsBetaPackage>
		<Description>Expectations for XML for aweXpect.</Description>
		<PackageProjectUrl>https://docs.testably.org/Extensions/aweXpect.Xml</PackageProjectUrl>
		<PackageReadmeSourceFile>$(RepositoryRoot)Docs/extensions/aweXpect.Xml/00-index.md</PackageReadmeSourceFile>
		<PackageReadmeSourceFile Condition="Exists('$(RepositoryRoot)Artifacts/aweXpect.Xml/README.md')">$(RepositoryRoot)Artifacts/aweXpect.Xml/README.md</PackageReadmeSourceFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\aweXpect.Core\aweXpect.Core.csproj" PrivateAssets="contentfiles;analyzers;build"/>
		<ProjectReference Include="..\aweXpect.Core.Generators\aweXpect.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
	</ItemGroup>

</Project>
