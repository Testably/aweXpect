<Project>

	<!-- A local build only warns about a public API that is not declared yet (RS0016) or that is declared but no longer
	     exists (RS0017), so a change can be iterated on before the entries are updated. On GitHub Actions every
	     build fails on both, because under the build scope `CoreOnly` the pipeline builds `aweXpect` only in Debug.
	     This lives in a .targets file because `Configuration` receives its default only after Directory.Build.props
	     is evaluated, so a build without an explicit configuration would not match the condition there. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(GITHUB_ACTIONS)' != 'true'">
		<WarningsNotAsErrors>$(WarningsNotAsErrors);RS0016;RS0017</WarningsNotAsErrors>
	</PropertyGroup>

</Project>
